{
    "name": "mintable",
    "author": "Kevin Schaich <schaich.kevin@gmail.com> (http://kevinschaich.io)",
    "license": "MIT",
    "version": "3.0.0-rc.1",
    "private": true,
    "bin": "./lib/scripts/cli.js",
    "preferGlobal": true,
    "engines": {
        "node": ">=24"
    },
    "scripts": {
        "build": "node scripts/clean-lib.js && tsc && node scripts/generate-schema.js",
        "watch": "tsc --watch",
        "lint": "prettier --check \"src/**/*.{js,html,ts}\" \"docs/**/*.json\" \"test/**/*.js\" \"scripts/**/*.js\"",
        "lint-fix": "prettier --write \"src/**/*.{js,html,ts}\" \"docs/**/*.json\" \"test/**/*.js\" \"scripts/**/*.js\"",
        "test": "npm run build && npm run lint && node --test",
        "prepack": "npm run build"
    },
    "files": [
        "lib",
        "src/integrations/teller/account-setup.html",
        "src/integrations/teller/account-setup.js",
        "docs/README.md",
        "docs/release-v3.md",
        "docs/templates",
        "docs/css/account-setup.css",
        "docs/img/icon.png"
    ],
    "dependencies": {
        "ajv": "8.20.0",
        "chalk": "4.1.2",
        "csv-parse": "7.0.3",
        "csv-stringify": "6.9.0",
        "date-fns": "4.4.0",
        "express": "4.22.3",
        "glob": "13.0.6",
        "google-auth-library": "11.3.1",
        "googleapis": "186.0.0",
        "jsonc": "^2.0.0",
        "lodash": "4.18.1",
        "open": "7.4.2",
        "prompts": "2.4.2",
        "yargs": "17.7.2"
    },
    "devDependencies": {
        "@types/express": "4.17.25",
        "@types/lodash": "4.17.26",
        "@types/node": "24.19.2",
        "@types/prompts": "2.4.9",
        "@types/yargs": "17.0.35",
        "prettier": "3.9.10",
        "typescript": "5.9.3",
        "typescript-json-schema": "0.68.0"
    },
    "description": "Self-hosted personal finance imports from Teller or CSV to Google Sheets or CSV.",
    "keywords": [
        "finance",
        "finance-management",
        "personal-finance",
        "sheets-api",
        "google-sheets",
        "google-sheets-api",
        "teller",
        "teller-api",
        "analytics",
        "tracker",
        "finance-tracker",
        "spreadsheet",
        "mintable",
        "money",
        "budget",
        "budgeting",
        "budget-management",
        "javascript"
    ]
}
