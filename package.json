{
    "name": "mintable",
    "author": "Kevin Schaich <schaich.kevin@gmail.com> (http://kevinschaich.io)",
    "license": "MIT",
    "version": "2.0.3",
    "bin": "./lib/scripts/cli.js",
    "preferGlobal": true,
    "engines": {
        "node": ">=24"
    },
    "scripts": {
        "build": "tsc && node scripts/generate-schema.js",
        "watch": "tsc --watch",
        "lint": "prettier --check \"src/**/*.{js,html,ts}\" \"docs/**/*.json\" \"test/**/*.js\" \"scripts/**/*.js\"",
        "lint-fix": "prettier --write \"src/**/*.{js,html,ts}\" \"docs/**/*.json\" \"test/**/*.js\" \"scripts/**/*.js\"",
        "test": "npm run build && npm run lint && node --test",
        "prepack": "npm run build"
    },
    "files": [
        "src",
        "lib",
        "docs",
        "tsconfig.json"
    ],
    "dependencies": {
        "ajv": "8.20.0",
        "body-parser": "1.20.8",
        "chalk": "4.1.2",
        "csv-parse": "7.0.3",
        "csv-stringify": "6.9.0",
        "date-fns": "4.4.0",
        "express": "4.22.3",
        "glob": "13.0.6",
        "google-auth-library": "11.3.1",
        "googleapis": "186.0.0",
        "jsonc": "^2.0.0",
        "lodash": "4.18.1",
        "open": "7.4.2",
        "plaid": "^7.0.0",
        "prompts": "2.4.2",
        "yargs": "17.7.2"
    },
    "devDependencies": {
        "@types/body-parser": "1.19.6",
        "@types/express": "4.17.25",
        "@types/lodash": "4.17.26",
        "@types/node": "24.19.2",
        "@types/prompts": "2.4.9",
        "@types/yargs": "17.0.35",
        "prettier": "3.9.10",
        "typescript": "5.9.3",
        "typescript-json-schema": "0.68.0"
    },
    "description": "Automate your personal finances – for free, with no ads, and no data collection.",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/kevinschaich/mintable.git"
    },
    "keywords": [
        "finance",
        "finance-management",
        "personal-finance",
        "mint",
        "sheets-api",
        "google-sheets",
        "google-sheets-api",
        "plaid",
        "plaid-api",
        "analytics",
        "tracker",
        "finance-tracker",
        "personal-capital",
        "spreadsheet",
        "mintable",
        "money",
        "budget",
        "budgeting",
        "budget-management",
        "javascript"
    ],
    "bugs": {
        "url": "https://github.com/kevinschaich/mintable/issues"
    },
    "homepage": "https://github.com/kevinschaich/mintable#readme"
}
